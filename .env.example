# Midaz Receivables Plugin Environment Configuration
ENV_NAME=development
LOG_LEVEL=info
SERVER_ADDRESS=0.0.0.0:8082
PLUGIN_HOST=http://localhost:8082

# Cryptographic Master Key for runtime AES-256-GCM encryption/decryption (32 bytes or 64 hex characters)
CREDENTIALS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# PostgreSQL Database Configuration
DB_HOST=receivables-postgres
DB_PORT=5432
DB_USER=midaz
DB_PASSWORD=midaz
DB_NAME=plugin_receivables
DB_SSLMODE=disable
DB_AUTO_MIGRATE=true
# DATABASE_URL=postgres://midaz:midaz@receivables-postgres:5432/plugin_receivables?sslmode=disable

# Midaz Ledger API Configuration
MIDAZ_ONBOARDING_URL=http://midaz-onboarding:3000
MIDAZ_TRANSACTION_URL=http://midaz-transaction:3001
MIDAZ_ORGANIZATION_ID=01948df2-0000-7000-8000-000000000001
MIDAZ_LEDGER_ID=01948df2-0000-7000-8000-000000000002
MIDAZ_CLEARING_ACCOUNT_ALIAS=@external/BRL:universal
MIDAZ_AUTH_TOKEN=

# Matcher 6 Reconciliation Bridge Configuration (:4018)
MATCHER_URL=http://host.docker.internal:4018
MATCHER_CONTEXT_SLUG=acquirers-settlement
MATCHER_WEBHOOK_SECRET=secret_matcher_local_123
MATCHER_UPLOAD_WINDOW_DAYS=7

# Worker Execution Schedule
SYNC_INTERVAL_MINUTES=60
WORKER_BATCH_LIMIT=500
